# Enforce LF line endings everywhere in the repo.
* text=auto eol=lf

# Source
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.ico binary
*.aep binary

# Colour data. LUT and DCTL files are byte-exact deliverables verified against
# their upstream build; line-ending normalization would break that guarantee.
*.cube binary
*.dctl binary
