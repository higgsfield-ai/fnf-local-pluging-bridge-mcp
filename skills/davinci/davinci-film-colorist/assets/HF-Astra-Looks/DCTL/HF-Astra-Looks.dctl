DEFINE_UI_TOOLTIP(Contrast, "One signed monotonic Y curve before palettes. Adjustable linear-light pivot; neutral default is 18 percent. Not a display transform.")
DEFINE_UI_TOOLTIP(Saturation, "Radial linear DWG chroma gain around equal Y. One is neutral.")
DEFINE_UI_TOOLTIP(Hue Degrees, "Opponent hue rotation. Warm protection applies. This is not a calibrated perceptual hue angle.")
