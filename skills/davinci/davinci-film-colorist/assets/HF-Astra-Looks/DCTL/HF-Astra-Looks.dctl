DEFINE_LUT(ASTRA_FB_PORTRA, ASTRA_LookMixer_Data/portra.cube);
DEFINE_LUT(ASTRA_FB_EKTACHROME, ASTRA_LookMixer_Data/ektachrome.cube);
DEFINE_LUT(ASTRA_FB_VISION2, ASTRA_LookMixer_Data/vision2.cube);
DEFINE_LUT(ASTRA_FB_VISION3D, ASTRA_LookMixer_Data/vision3d.cube);
DEFINE_LUT(ASTRA_FB_VISION3T, ASTRA_LookMixer_Data/vision3t.cube);

// ASTRA LookMixer v04 Optimized - shared analytic work and external native LUTs.
// IN / OUT: DaVinci Wide Gamut / DaVinci Intermediate.
// Group Post-Clip: after shot balance, before the single output CST/DRT.
// LUT Source: DWG/DI; LUT output: RCM SDR, requires matching SDR output DRT.
// Five original-size 65^3 cubes are referenced externally; no film-look engine texture processing.
// LUT input coordinates clamp to the documented cube domain [0,1]; no extrapolation.
// Export settings are preserved in each external cube file.
// Normal mode blends independent palette outputs in LINEAR DWG.
// Zero palette weights bypass palettes ONLY; global controls remain active.

